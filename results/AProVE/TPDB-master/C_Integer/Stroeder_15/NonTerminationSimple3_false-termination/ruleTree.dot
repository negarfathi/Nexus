6 [label="nonterm accelerated rule: 6",style=filled, fillcolor=darkorchid];
3 [label="initial rule: 3: f_101 -> f_101",style=filled, fillcolor=darkseagreen];
10 -> 2 [];
10 -> 6 [];
6 -> 3 [];
}