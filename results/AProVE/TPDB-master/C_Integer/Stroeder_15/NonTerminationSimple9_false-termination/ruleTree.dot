digraph dp_graph {
graph [mindist=0.3,nodesep=0.20,concentrate=true,ranksep=0.1];
node [shape=rectangle,fontsize=10];
edge [labeldistance=3,headclip=true,fontsize=8];
10 [label="chained rule: 10",style=filled, fillcolor=lightblue];
1 [label="initial rule: 1: f_52 -> f_85",style=filled, fillcolor=darkseagreen];
6 [label="nonterm accelerated rule: 6",style=filled, fillcolor=darkorchid];
0 [label="initial rule: 0: f_85 -> f_85",style=filled, fillcolor=darkseagreen];
10 -> 1 [];
10 -> 6 [];
6 -> 0 [];
}