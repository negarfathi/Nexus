digraph dp_graph {
graph [mindist=0.3,nodesep=0.20,concentrate=true,ranksep=0.1];
node [shape=rectangle,fontsize=10];
edge [labeldistance=3,headclip=true,fontsize=8];
5 [label="chained rule: 5",style=filled, fillcolor=lightblue];
1 [label="initial rule: 1: f_70 -> f_126",style=filled, fillcolor=darkseagreen];
4 [label="nonterm accelerated rule: 4",style=filled, fillcolor=darkorchid];
0 [label="initial rule: 0: f_126 -> f_126",style=filled, fillcolor=darkseagreen];
5 -> 1 [];
5 -> 4 [];
4 -> 0 [];
}