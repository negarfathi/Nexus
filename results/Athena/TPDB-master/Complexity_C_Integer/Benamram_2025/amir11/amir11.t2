///*** 1_loop ***///
START: loop_bb0;

FROM: loop_bb0;
var__temp_v.04 := vx4;
var__temp_v.01 := vx2;
var__temp_v.0 := vx1;
TO: loop_bb1;

FROM: loop_bb1;
v.04 := var__temp_v.04;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
TO: loop_bb1_end;

FROM: loop_bb1_end;
assume(v.01 > 0);
TO: loop_bb2;

FROM: loop_bb1_end;
assume(v.01 <= 0);
TO: loop_bb7;

FROM: loop_bb2;
TO: loop_bb2_end;

FROM: loop_bb2_end;
assume(v.0 > 0);
TO: loop_bb3;

FROM: loop_bb2_end;
assume(v.0 <= 0);
TO: loop_bb6;

FROM: loop_bb3;
v2 := v.0 - 2;
v3 := v.04 + 1;
var__temp_v.03 := v3;
var__temp_v.12 := v.01;
TO: loop_bb4;

FROM: loop_bb4;
v.03 := var__temp_v.03;
v.12 := var__temp_v.12;
var__temp_v.04 := v3;
var__temp_v.01 := v.12;
var__temp_v.0 := v2;
TO: loop_bb4_end;

FROM: loop_bb4_end;
assume(v.03 > 0);
TO: loop_bb5;

FROM: loop_bb4_end;
assume(v.03 <= 0);
TO: loop_bb1;

FROM: loop_bb5;
v5 := v.12 + v.03;
v6 := v.03 + -1;
var__temp_v.03 := v6;
var__temp_v.12 := v5;
TO: loop_bb4;

FROM: loop_bb6;
v7 := v.01 + -1;
v8 := 0 - v.0;
v9 := v8 - 2;
var__temp_v.04 := v.04;
var__temp_v.01 := v7;
var__temp_v.0 := v9;
TO: loop_bb1;

FROM: loop_bb7;
TO: loop_bb7_ret;

