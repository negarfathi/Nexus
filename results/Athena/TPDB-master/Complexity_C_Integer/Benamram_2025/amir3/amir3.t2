///*** 1_amir3 ***///
START: amir3_bb0;

FROM: amir3_bb0;
var__temp_v.01 := vx1;
var__temp_v.0 := vx5;
TO: amir3_bb1;

FROM: amir3_bb1;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
v0 := v.0 + -1;
var__temp_v.1 := v.01;
TO: amir3_bb1_end;

FROM: amir3_bb1_end;
assume(v.0 > 0);
TO: amir3_bb2;

FROM: amir3_bb1_end;
assume(v.0 <= 0);
TO: amir3_bb3;

FROM: amir3_bb2;
v2 := nondet();
v4 := v.01 + vx2;
TO: amir3_bb2_vx2.;
FROM: amir3_bb2_vx2.;
assume(v2 != 0);
vx2. := vx2;
TO: amir3_bb2_svx2.;

FROM: amir3_bb2_vx2.;
assume(v2 == 0);
vx2. := v4;
TO: amir3_bb2_svx2.;

FROM: amir3_bb2_svx2.;
TO: amir3_bb2_v.x2;
FROM: amir3_bb2_v.x2;
assume(v2 != 0);
v.x2 := v4;
TO: amir3_bb2_sv.x2;

FROM: amir3_bb2_v.x2;
assume(v2 == 0);
v.x2 := vx2;
TO: amir3_bb2_sv.x2;

FROM: amir3_bb2_sv.x2;
v5 := v.x2 + vx2.;
var__temp_v.01 := v5;
var__temp_v.0 := v0;
TO: amir3_bb1;

FROM: amir3_bb3;
v.1 := var__temp_v.1;
TO: amir3_bb3_end;

FROM: amir3_bb3_end;
assume(v.1 > 0);
TO: amir3_bb4;

FROM: amir3_bb3_end;
assume(v.1 <= 0);
TO: amir3_bb5;

FROM: amir3_bb4;
v7 := v.1 + -1;
var__temp_v.1 := v7;
TO: amir3_bb3;

FROM: amir3_bb5;
TO: amir3_bb5_ret;

