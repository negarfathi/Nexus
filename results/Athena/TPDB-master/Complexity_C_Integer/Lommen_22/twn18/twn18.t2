FROM: twn18_bb3;
v6 := 3 * v.01;
v7 := 4 * v.02;
v8 := v6 - v7;
v9 := 4 * v.01;
v10 := 3 * v.02;
v11 := v9 - v10;
v12 := 5 * v.03;
v13 := 5 * v.04;
v14 := va * va;
v15 := v13 - v14;
var__temp_v.04 := v15;
var__temp_v.03 := v12;
var__temp_v.02 := v11;
var__temp_v.01 := v8;
