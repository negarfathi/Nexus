///*** 1_foo ***///
START: foo_bb0;

FROM: foo_bb0;
TO: foo_bb0_end;

FROM: foo_bb0_end;
assume((0 <= vid) && (vid < vmaxId));
TO: foo_bb1;

FROM: foo_bb0_end;
assume((0 > vid) || (vid >= vmaxId));
TO: foo_.critedge;

FROM: foo_bb1;
v2 := vid + 1;
var__temp_v.0 := v2;
TO: foo_bb2;

FROM: foo_bb2;
v.0 := var__temp_v.0;
TO: foo_bb2_end;

FROM: foo_bb2_end;
assume(v.0 != vid);
TO: foo_bb3;

FROM: foo_bb2_end;
assume(v.0 == vid);
TO: foo_.critedge;

FROM: foo_bb3;
v4 := nondet();
TO: foo_bb3_end;

FROM: foo_bb3_end;
assume(v4 != 0);
TO: foo_bb4;

FROM: foo_bb3_end;
assume(v4 == 0);
TO: foo_.critedge;

FROM: foo_bb4;
v7 := v.0 + 1;
TO: foo_bb4_v.1;
FROM: foo_bb4_v.1;
assume(v.0 <= vmaxId);
v.1 := v7;
TO: foo_bb4_sv.1;

FROM: foo_bb4_v.1;
assume(v.0 > vmaxId);
v.1 := 0;
TO: foo_bb4_sv.1;

FROM: foo_bb4_sv.1;
var__temp_v.0 := v.1;
TO: foo_bb2;

FROM: foo_.critedge;
TO: foo_.critedge_ret;

