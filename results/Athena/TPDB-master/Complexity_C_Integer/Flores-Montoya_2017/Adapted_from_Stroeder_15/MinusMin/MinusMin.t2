///*** 1_foo ***///
START: foo_bb0;

FROM: foo_bb0;
TO: foo_bb0_vx.y;
FROM: foo_bb0_vx.y;
assume(vx < vy);
vx.y := vx;
TO: foo_bb0_svx.y;

FROM: foo_bb0_vx.y;
assume(vx >= vy);
vx.y := vy;
TO: foo_bb0_svx.y;

FROM: foo_bb0_svx.y;
var__temp_v.1 := vx.y;
var__temp_v.01 := 0;
var__temp_v.0 := vy;
TO: foo_bb1;

FROM: foo_bb1;
v.1 := var__temp_v.1;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
TO: foo_bb1_end;

FROM: foo_bb1_end;
assume(v.1 == v.0);
TO: foo_bb2;

FROM: foo_bb1_end;
assume(v.1 != v.0);
TO: foo_bb3;

FROM: foo_bb2;
v2 := v.0 + 1;
v3 := v.01 + 1;
TO: foo_bb2_vx.;
FROM: foo_bb2_vx.;
assume(vx < v2);
vx. := vx;
TO: foo_bb2_svx.;

FROM: foo_bb2_vx.;
assume(vx >= v2);
vx. := v2;
TO: foo_bb2_svx.;

FROM: foo_bb2_svx.;
var__temp_v.1 := vx.;
var__temp_v.01 := v3;
var__temp_v.0 := v2;
TO: foo_bb1;

FROM: foo_bb3;
TO: foo_bb3_ret;

