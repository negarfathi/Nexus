///*** 1_speed_popl10_simple_single_2 ***///
START: speed_popl10_simple_single_2_bb0;

FROM: speed_popl10_simple_single_2_bb0;
var__temp_vy.0 := 0;
var__temp_vx.0 := 0;
TO: speed_popl10_simple_single_2_bb1;

FROM: speed_popl10_simple_single_2_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
TO: speed_popl10_simple_single_2_bb1_end;

FROM: speed_popl10_simple_single_2_bb1_end;
assume(vx.0 < vn);
TO: speed_popl10_simple_single_2_bb2;

FROM: speed_popl10_simple_single_2_bb1_end;
assume(vx.0 >= vn);
TO: speed_popl10_simple_single_2_bb3;

FROM: speed_popl10_simple_single_2_bb2;
v1 := vx.0 + 1;
v2 := vy.0 + 1;
var__temp_vy.0 := v2;
var__temp_vx.0 := v1;
TO: speed_popl10_simple_single_2_bb1;

FROM: speed_popl10_simple_single_2_bb3;
TO: speed_popl10_simple_single_2_bb3_end;

FROM: speed_popl10_simple_single_2_bb3_end;
assume(vy.0 < vm);
TO: speed_popl10_simple_single_2_bb4;

FROM: speed_popl10_simple_single_2_bb3_end;
assume(vy.0 >= vm);
TO: speed_popl10_simple_single_2_bb5;

FROM: speed_popl10_simple_single_2_bb4;
v4 := vx.0 + 1;
v5 := vy.0 + 1;
var__temp_vy.0 := v5;
var__temp_vx.0 := v4;
TO: speed_popl10_simple_single_2_bb1;

FROM: speed_popl10_simple_single_2_bb5;
TO: speed_popl10_simple_single_2_bb5_ret;

