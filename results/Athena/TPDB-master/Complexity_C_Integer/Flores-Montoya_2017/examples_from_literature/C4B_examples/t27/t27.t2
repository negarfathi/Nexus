///*** 1_t27 ***///
START: t27_bb0;

FROM: t27_bb0;
var__temp_v.01 := vy;
var__temp_v.0 := vn;
TO: t27_bb1;

FROM: t27_bb1;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
TO: t27_bb1_end;

FROM: t27_bb1_end;
assume(v.0 < 0);
TO: t27_bb2;

FROM: t27_bb1_end;
assume(v.0 >= 0);
TO: t27_bb5;

FROM: t27_bb2;
v1 := v.0 + 1;
v2 := v.01 + 1000;
var__temp_v.1 := v2;
TO: t27_bb3;

FROM: t27_bb3;
v.1 := var__temp_v.1;
var__temp_v.01 := v.1;
var__temp_v.0 := v1;
TO: t27_bb3_end;

FROM: t27_bb3_end;
assume(v.1 >= 100);
TO: t27_bb4;

FROM: t27_bb3_end;
assume(v.1 < 100);
TO: t27_bb1;

FROM: t27_bb4;
