///*** 1_speed_popl10_nested_single ***///
START: speed_popl10_nested_single_bb0;

FROM: speed_popl10_nested_single_bb0;
var__temp_vx.0 := 0;
TO: speed_popl10_nested_single_bb1;

FROM: speed_popl10_nested_single_bb1;
vx.0 := var__temp_vx.0;
var__temp_vx.0.sink := vx.0;
TO: speed_popl10_nested_single_bb1_end;

FROM: speed_popl10_nested_single_bb1_end;
assume(vx.0 < vn);
TO: speed_popl10_nested_single_bb2;

FROM: speed_popl10_nested_single_bb1_end;
assume(vx.0 >= vn);
TO: speed_popl10_nested_single_bb4;

FROM: speed_popl10_nested_single_bb2;
vx.0.sink := var__temp_vx.0.sink;
v1 := vx.0.sink + 1;
var__temp_vx.0 := v1;
TO: speed_popl10_nested_single_bb2_end;

FROM: speed_popl10_nested_single_bb2_end;
assume(v1 < vn);
TO: speed_popl10_nested_single_bb3;

FROM: speed_popl10_nested_single_bb2_end;
assume(v1 >= vn);
TO: speed_popl10_nested_single_bb1;

FROM: speed_popl10_nested_single_bb3;
v3 := nondet();
var__temp_vx.0 := v1;
var__temp_vx.0.sink := v1;
TO: speed_popl10_nested_single_bb3_end;

FROM: speed_popl10_nested_single_bb3_end;
assume(v3 > 0);
TO: speed_popl10_nested_single_bb1;

FROM: speed_popl10_nested_single_bb3_end;
assume(v3 <= 0);
TO: speed_popl10_nested_single_bb2;

FROM: speed_popl10_nested_single_bb4;
TO: speed_popl10_nested_single_bb4_ret;

