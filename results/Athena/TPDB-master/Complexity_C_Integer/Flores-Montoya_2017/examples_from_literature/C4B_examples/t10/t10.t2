///*** 1_t10 ***///
START: t10_bb0;

FROM: t10_bb0;
var__temp_v.01 := vy;
var__temp_v.0 := vx;
TO: t10_bb1;

FROM: t10_bb1;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
TO: t10_bb1_end;

FROM: t10_bb1_end;
assume(v.0 > v.01);
TO: t10_bb2;

FROM: t10_bb1_end;
assume(v.0 <= v.01);
TO: t10_bb3;

FROM: t10_bb2;
v1 := nondet();
v3 := v.01 + 1;
v4 := v.0 - 1;
TO: t10_bb2_v.12;
FROM: t10_bb2_v.12;
assume(v1 > 0);
v.12 := v3;
TO: t10_bb2_sv.12;

FROM: t10_bb2_v.12;
assume(v1 <= 0);
v.12 := v.01;
TO: t10_bb2_sv.12;

FROM: t10_bb2_sv.12;
TO: t10_bb2_v.1;
FROM: t10_bb2_v.1;
assume(v1 > 0);
v.1 := v.0;
TO: t10_bb2_sv.1;

FROM: t10_bb2_v.1;
assume(v1 <= 0);
v.1 := v4;
TO: t10_bb2_sv.1;

FROM: t10_bb2_sv.1;
var__temp_v.01 := v.12;
var__temp_v.0 := v.1;
TO: t10_bb1;

FROM: t10_bb3;
TO: t10_bb3_ret;

