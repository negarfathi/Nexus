///*** 1_speed_pldi09_fig1 ***///
START: speed_pldi09_fig1_bb0;

FROM: speed_pldi09_fig1_bb0;
var__temp_vy.0 := 0;
var__temp_vx.0 := 0;
TO: speed_pldi09_fig1_bb1;

FROM: speed_pldi09_fig1_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
TO: speed_pldi09_fig1_bb1_end;

FROM: speed_pldi09_fig1_bb1_end;
assume(vx.0 < vn);
TO: speed_pldi09_fig1_bb2;

FROM: speed_pldi09_fig1_bb1_end;
assume(vx.0 >= vn);
TO: speed_pldi09_fig1_bb3;

FROM: speed_pldi09_fig1_bb2;
v1 := vy.0 + 1;
v2 := vx.0 + 1;
var__temp_vy.0 := v1;
var__temp_vx.0 := v2;
TO: speed_pldi09_fig1_bb1;

FROM: speed_pldi09_fig1_bb3;
TO: speed_pldi09_fig1_bb3_end;

FROM: speed_pldi09_fig1_bb3_end;
assume(vy.0 > 0);
TO: speed_pldi09_fig1_bb4;

FROM: speed_pldi09_fig1_bb3_end;
assume(vy.0 <= 0);
TO: speed_pldi09_fig1_bb5;

FROM: speed_pldi09_fig1_bb4;
v4 := vy.0 - 1;
var__temp_vy.0 := v4;
var__temp_vx.0 := vx.0;
TO: speed_pldi09_fig1_bb1;

FROM: speed_pldi09_fig1_bb5;
TO: speed_pldi09_fig1_bb5_ret;

