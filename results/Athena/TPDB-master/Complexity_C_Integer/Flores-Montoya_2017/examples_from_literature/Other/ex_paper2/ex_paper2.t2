///*** 1_ex_paper2 ***///
START: ex_paper2_bb0;

FROM: ex_paper2_bb0;
var__temp_vx.0 := 1;
TO: ex_paper2_bb1;

FROM: ex_paper2_bb1;
vx.0 := var__temp_vx.0;
var__temp_vy.0 := vx.0;
TO: ex_paper2_bb1_end;

FROM: ex_paper2_bb1_end;
assume(vx.0 <= vn);
TO: ex_paper2_bb2;

FROM: ex_paper2_bb1_end;
assume(vx.0 > vn);
TO: ex_paper2_bb5;

FROM: ex_paper2_bb2;
vy.0 := var__temp_vy.0;
TO: ex_paper2_bb2_end;

FROM: ex_paper2_bb2_end;
assume(vy.0 <= vn);
TO: ex_paper2_bb3;

FROM: ex_paper2_bb2_end;
assume(vy.0 > vn);
TO: ex_paper2_bb4;

FROM: ex_paper2_bb3;
v2 := vy.0 + 1;
var__temp_vy.0 := v2;
TO: ex_paper2_bb2;

FROM: ex_paper2_bb4;
v3 := vx.0 + 1;
var__temp_vx.0 := v3;
TO: ex_paper2_bb1;

FROM: ex_paper2_bb5;
TO: ex_paper2_bb5_ret;

