var__temp_vmax.1 := v.i.0;
TO: heapsort_bb5;

FROM: heapsort_bb5;
vmax.1 := var__temp_vmax.1;
var__temp_vmax.3 := vmax.1;
TO: heapsort_bb5_end;

FROM: heapsort_bb5_end;
assume(v4 <= vsize);
TO: heapsort_bb6;

FROM: heapsort_bb5_end;
assume(v4 > vsize);
TO: heapsort_bb8;

FROM: heapsort_bb6;
TO: heapsort_bb6_end;

FROM: heapsort_bb6_end;
assume((v4 < 1) || (v4 > vsize));
TO: heapsort_bb11;

FROM: heapsort_bb6_end;
assume((v4 >= 1) && (v4 <= vsize));
TO: heapsort_bb7;

FROM: heapsort_bb7;
v13 := nondet();
TO: heapsort_bb7_v.max.1;
FROM: heapsort_bb7_v.max.1;
assume(v13 > 0);
v.max.1 := v4;
TO: heapsort_bb7_sv.max.1;

FROM: heapsort_bb7_v.max.1;
assume(v13 <= 0);
v.max.1 := vmax.1;
TO: heapsort_bb7_sv.max.1;

FROM: heapsort_bb7_sv.max.1;
var__temp_vmax.3 := v.max.1;
TO: heapsort_bb8;

FROM: heapsort_bb8;
vmax.3 := var__temp_vmax.3;
TO: heapsort_bb8_end;

FROM: heapsort_bb8_end;
assume(vi.0 != vmax.3);
TO: heapsort_bb9;

FROM: heapsort_bb8_end;
assume(vi.0 == vmax.3);
TO: heapsort_bb11;

FROM: heapsort_bb9;
TO: heapsort_bb9_end;

FROM: heapsort_bb9_end;
assume((vi.0 < 1) || (vi.0 > vsize));
TO: heapsort_bb11;

FROM: heapsort_bb9_end;
assume((vi.0 >= 1) && (vi.0 <= vsize));
TO: heapsort_bb10;

FROM: heapsort_bb10;
