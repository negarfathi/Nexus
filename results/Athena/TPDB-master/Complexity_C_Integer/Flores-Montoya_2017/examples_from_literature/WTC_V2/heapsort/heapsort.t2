FROM: heapsort_bb1_end;
assume((vsize > 0) && (vi.0 >= 1));
TO: heapsort_bb2;

FROM: heapsort_bb1_end;
assume((vsize <= 0) || (vi.0 < 1));
TO: heapsort_bb11;

FROM: heapsort_bb2;
v2 := 2 * vi.0;
v3 := 2 * vi.0;
v4 := v3 + 1;
var__temp_vmax.1 := vi.0;
TO: heapsort_bb2_end;

FROM: heapsort_bb2_end;
assume(v2 <= vsize);
TO: heapsort_bb3;

FROM: heapsort_bb2_end;
assume(v2 > vsize);
TO: heapsort_bb5;

FROM: heapsort_bb3;
TO: heapsort_bb3_end;

FROM: heapsort_bb3_end;
assume((v2 < 1) || (v2 > vsize));
TO: heapsort_bb11;

FROM: heapsort_bb3_end;
assume((v2 >= 1) && (v2 <= vsize));
TO: heapsort_bb4;

FROM: heapsort_bb4;
v8 := nondet();
TO: heapsort_bb4_v.i.0;
FROM: heapsort_bb4_v.i.0;
assume(v8 > 0);
v.i.0 := v2;
TO: heapsort_bb4_sv.i.0;

FROM: heapsort_bb4_v.i.0;
assume(v8 <= 0);
v.i.0 := vi.0;
