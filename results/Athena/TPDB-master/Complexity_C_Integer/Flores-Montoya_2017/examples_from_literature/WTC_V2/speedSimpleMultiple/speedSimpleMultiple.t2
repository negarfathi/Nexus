///*** 1_speedSimpleMultiple ***///
START: speedSimpleMultiple_bb0;

FROM: speedSimpleMultiple_bb0;
var__temp_vy.0 := 0;
var__temp_vx.0 := 0;
TO: speedSimpleMultiple_bb1;

FROM: speedSimpleMultiple_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
TO: speedSimpleMultiple_bb1_end;

FROM: speedSimpleMultiple_bb1_end;
assume(vx.0 < vn);
TO: speedSimpleMultiple_bb2;

FROM: speedSimpleMultiple_bb1_end;
assume(vx.0 >= vn);
TO: speedSimpleMultiple_bb3;

FROM: speedSimpleMultiple_bb2;
v2 := vy.0 + 1;
v3 := vx.0 + 1;
TO: speedSimpleMultiple_bb2_vy.1;
FROM: speedSimpleMultiple_bb2_vy.1;
assume(vy.0 < vm);
vy.1 := v2;
TO: speedSimpleMultiple_bb2_svy.1;

FROM: speedSimpleMultiple_bb2_vy.1;
assume(vy.0 >= vm);
vy.1 := vy.0;
TO: speedSimpleMultiple_bb2_svy.1;

FROM: speedSimpleMultiple_bb2_svy.1;
TO: speedSimpleMultiple_bb2_vx.1;
FROM: speedSimpleMultiple_bb2_vx.1;
assume(vy.0 < vm);
vx.1 := vx.0;
TO: speedSimpleMultiple_bb2_svx.1;

FROM: speedSimpleMultiple_bb2_vx.1;
assume(vy.0 >= vm);
vx.1 := v3;
TO: speedSimpleMultiple_bb2_svx.1;

FROM: speedSimpleMultiple_bb2_svx.1;
var__temp_vy.0 := vy.1;
var__temp_vx.0 := vx.1;
TO: speedSimpleMultiple_bb1;

FROM: speedSimpleMultiple_bb3;
TO: speedSimpleMultiple_bb3_ret;

