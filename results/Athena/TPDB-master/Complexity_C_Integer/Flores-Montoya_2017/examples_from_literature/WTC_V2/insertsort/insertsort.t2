///*** 1_insertsort ***///
START: insertsort_bb0;

FROM: insertsort_bb0;
var__temp_vi.0 := 1;
TO: insertsort_bb1;

FROM: insertsort_bb1;
vi.0 := var__temp_vi.0;
TO: insertsort_bb1_end;

FROM: insertsort_bb1_end;
assume(vi.0 < vlength);
TO: insertsort_bb2;

FROM: insertsort_bb1_end;
assume(vi.0 >= vlength);
TO: insertsort_bb6;

FROM: insertsort_bb2;
v1 := nondet();
v2 := vi.0 - 1;
var__temp_vj.0 := v2;
TO: insertsort_bb3;

FROM: insertsort_bb3;
vj.0 := var__temp_vj.0;
TO: insertsort_bb3_end;

FROM: insertsort_bb3_end;
assume(vj.0 >= 0);
TO: insertsort_bb4;

FROM: insertsort_bb3_end;
assume(vj.0 < 0);
TO: insertsort_.critedge;

FROM: insertsort_bb4;
v4 := nondet();
TO: insertsort_bb4_end;

FROM: insertsort_bb4_end;
assume(v4 > v1);
TO: insertsort_bb5;

FROM: insertsort_bb4_end;
assume(v4 <= v1);
TO: insertsort_.critedge;

FROM: insertsort_bb5;
v6 := vj.0 + -1;
var__temp_vj.0 := v6;
TO: insertsort_bb3;

FROM: insertsort_.critedge;
v7 := vi.0 + 1;
var__temp_vi.0 := v7;
TO: insertsort_bb1;

FROM: insertsort_bb6;
TO: insertsort_bb6_ret;

