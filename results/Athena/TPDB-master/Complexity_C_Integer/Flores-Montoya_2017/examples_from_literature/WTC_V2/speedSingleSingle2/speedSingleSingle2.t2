///*** 1_speedSingleSingle2 ***///
START: speedSingleSingle2_bb0;

FROM: speedSingleSingle2_bb0;
var__temp_vy.0 := 0;
var__temp_vx.0 := 0;
TO: speedSingleSingle2_bb0_end;

FROM: speedSingleSingle2_bb0_end;
assume((vn < 0) || (vm < 0));
TO: speedSingleSingle2_bb6;

FROM: speedSingleSingle2_bb0_end;
assume((vn >= 0) && (vm >= 0));
TO: speedSingleSingle2_bb1;

FROM: speedSingleSingle2_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
v2 := nondet();
TO: speedSingleSingle2_bb1_end;

FROM: speedSingleSingle2_bb1_end;
assume(v2 > 0);
TO: speedSingleSingle2_bb2;

FROM: speedSingleSingle2_bb1_end;
assume(v2 <= 0);
TO: speedSingleSingle2_bb6;

FROM: speedSingleSingle2_bb2;
TO: speedSingleSingle2_bb2_end;

FROM: speedSingleSingle2_bb2_end;
assume(vx.0 < vn);
TO: speedSingleSingle2_bb3;

FROM: speedSingleSingle2_bb2_end;
assume(vx.0 >= vn);
TO: speedSingleSingle2_bb4;

FROM: speedSingleSingle2_bb3;
v5 := vx.0 + 1;
v6 := vy.0 + 1;
var__temp_vy.0 := v6;
var__temp_vx.0 := v5;
TO: speedSingleSingle2_bb1;

FROM: speedSingleSingle2_bb4;
TO: speedSingleSingle2_bb4_end;

FROM: speedSingleSingle2_bb4_end;
assume(vy.0 < vm);
TO: speedSingleSingle2_bb5;

FROM: speedSingleSingle2_bb4_end;
assume(vy.0 >= vm);
TO: speedSingleSingle2_bb6;

FROM: speedSingleSingle2_bb5;
v8 := vx.0 + 1;
v9 := vy.0 + 1;
var__temp_vy.0 := v9;
var__temp_vx.0 := v8;
TO: speedSingleSingle2_bb1;

FROM: speedSingleSingle2_bb6;
TO: speedSingleSingle2_bb6_ret;

