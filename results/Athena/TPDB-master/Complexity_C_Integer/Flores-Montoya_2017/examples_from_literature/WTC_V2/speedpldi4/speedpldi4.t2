///*** 1_speedpldi4 ***///
START: speedpldi4_bb0;

FROM: speedpldi4_bb0;
var__temp_vi.0 := vn;
TO: speedpldi4_bb0_end;

FROM: speedpldi4_bb0_end;
assume((vm <= 0) || (vn <= vm));
TO: speedpldi4_bb3;

FROM: speedpldi4_bb0_end;
assume((vm > 0) && (vn > vm));
TO: speedpldi4_bb1;

FROM: speedpldi4_bb1;
vi.0 := var__temp_vi.0;
TO: speedpldi4_bb1_end;

FROM: speedpldi4_bb1_end;
assume(vi.0 > 0);
TO: speedpldi4_bb2;

FROM: speedpldi4_bb1_end;
assume(vi.0 <= 0);
TO: speedpldi4_bb3;

FROM: speedpldi4_bb2;
v4 := vi.0 + -1;
v5 := vi.0 - vm;
TO: speedpldi4_bb2_vi.1;
FROM: speedpldi4_bb2_vi.1;
assume(vi.0 < vm);
vi.1 := v4;
TO: speedpldi4_bb2_svi.1;

FROM: speedpldi4_bb2_vi.1;
assume(vi.0 >= vm);
vi.1 := v5;
TO: speedpldi4_bb2_svi.1;

FROM: speedpldi4_bb2_svi.1;
var__temp_vi.0 := vi.1;
TO: speedpldi4_bb1;

FROM: speedpldi4_bb3;
TO: speedpldi4_bb3_ret;

