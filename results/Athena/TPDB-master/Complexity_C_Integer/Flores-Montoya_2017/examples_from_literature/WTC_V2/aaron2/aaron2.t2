FROM: aaron2_bb2;
v3 := nondet();
TO: aaron2_bb2_end;

FROM: aaron2_bb2_end;
assume(v3 > 0);
TO: aaron2_bb3;

FROM: aaron2_bb2_end;
assume(v3 <= 0);
TO: aaron2_bb4;

FROM: aaron2_bb3;
v5 := v.01 - 1;
v6 := v5 - vtx;
var__temp_v.02 := v.02;
var__temp_v.01 := v6;
