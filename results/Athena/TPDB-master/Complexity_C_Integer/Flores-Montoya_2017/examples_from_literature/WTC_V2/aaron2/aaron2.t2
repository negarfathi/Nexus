assume(vtx >= 0);
TO: aaron2_bb1;

FROM: aaron2_bb0_end;
assume(vtx < 0);
TO: aaron2_bb5;

FROM: aaron2_bb1;
v.02 := var__temp_v.02;
v.01 := var__temp_v.01;
TO: aaron2_bb1_end;

FROM: aaron2_bb1_end;
assume((v.01 < v.02) || (vtx < 0));
TO: aaron2_bb5;

FROM: aaron2_bb1_end;
assume((v.01 >= v.02) && (vtx >= 0));
