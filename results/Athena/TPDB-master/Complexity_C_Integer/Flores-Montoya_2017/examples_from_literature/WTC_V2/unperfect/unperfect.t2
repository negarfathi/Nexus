///*** 1_unperfect ***///
START: unperfect_bb0;

FROM: unperfect_bb0;
var__temp_vy3.0 := vx;
var__temp_vy1.0 := vx;
var__temp_v.0 := 0;
TO: unperfect_bb0_end;

FROM: unperfect_bb0_end;
assume(vx <= 0);
TO: unperfect_bb3;

FROM: unperfect_bb0_end;
assume(vx > 0);
TO: unperfect_bb1;

FROM: unperfect_bb1;
vy3.0 := var__temp_vy3.0;
vy1.0 := var__temp_vy1.0;
v1 := vy1.0 - 1;
var__temp_vy2.1 := vx;
TO: unperfect_bb1_end;

FROM: unperfect_bb1_end;
assume(v1 == 0);
TO: unperfect_bb2;

FROM: unperfect_bb1_end;
assume(v1 != 0);
TO: unperfect_bb4;

FROM: unperfect_bb2;
TO: unperfect_bb2_v3;

FROM: unperfect_bb2_v3;
assume(vy3.0 == 0);
v3 := 1;
TO: unperfect_bb2_sv3;

FROM: unperfect_bb2_v3;
assume(vy3.0 != 0);
v3 := 0;
TO: unperfect_bb2_sv3;

FROM: unperfect_bb2_sv3;
v4 := v3;
var__temp_v.0 := v4;
TO: unperfect_bb3;

FROM: unperfect_bb3;
v.0 := var__temp_v.0;
TO: unperfect_bb3_ret;

FROM: unperfect_bb4;
vy2.1 := var__temp_vy2.1;
TO: unperfect_bb4_end;

FROM: unperfect_bb4_end;
assume(vy2.1 >= v1);
TO: unperfect_bb5;

FROM: unperfect_bb4_end;
assume(vy2.1 < v1);
TO: unperfect_bb6;

FROM: unperfect_bb5;
v6 := vy2.1 - v1;
var__temp_vy2.1 := v6;
TO: unperfect_bb4;

FROM: unperfect_bb6;
v8 := vy3.0 - v1;
TO: unperfect_bb6_v.y3.0;
FROM: unperfect_bb6_v.y3.0;
assume(vy2.1 == 0);
v.y3.0 := v8;
TO: unperfect_bb6_sv.y3.0;

FROM: unperfect_bb6_v.y3.0;
assume(vy2.1 != 0);
v.y3.0 := vy3.0;
TO: unperfect_bb6_sv.y3.0;

FROM: unperfect_bb6_sv.y3.0;
var__temp_vy3.0 := v.y3.0;
var__temp_vy1.0 := v1;
TO: unperfect_bb1;

