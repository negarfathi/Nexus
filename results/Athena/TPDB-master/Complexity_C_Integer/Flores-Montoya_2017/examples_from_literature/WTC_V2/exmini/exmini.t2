///*** 1_exmini ***///
START: exmini_bb0;

FROM: exmini_bb0;
var__temp_v.02 := vk;
var__temp_v.01 := vj;
var__temp_v.0 := vi;
TO: exmini_bb1;

FROM: exmini_bb1;
v.02 := var__temp_v.02;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
TO: exmini_bb1_end;

FROM: exmini_bb1_end;
assume((v.0 <= 100) && (v.01 <= v.02));
TO: exmini_bb2;

FROM: exmini_bb1_end;
assume((v.0 > 100) || (v.01 > v.02));
TO: exmini_bb3;

FROM: exmini_bb2;
v2 := v.0 + 1;
v3 := v.02 - 1;
var__temp_v.02 := v3;
var__temp_v.01 := v2;
var__temp_v.0 := v.01;
TO: exmini_bb1;

FROM: exmini_bb3;
TO: exmini_bb3_ret;

