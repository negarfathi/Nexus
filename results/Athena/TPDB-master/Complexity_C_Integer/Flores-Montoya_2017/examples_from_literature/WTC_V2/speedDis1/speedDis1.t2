///*** 1_speedDis1 ***///
START: speedDis1_bb0;

FROM: speedDis1_bb0;
var__temp_v.01 := vy;
var__temp_v.0 := vx;
TO: speedDis1_bb1;

FROM: speedDis1_bb1;
v.01 := var__temp_v.01;
v.0 := var__temp_v.0;
TO: speedDis1_bb1_end;

FROM: speedDis1_bb1_end;
assume(v.0 < vn);
TO: speedDis1_bb2;

FROM: speedDis1_bb1_end;
assume(v.0 >= vn);
TO: speedDis1_bb3;

FROM: speedDis1_bb2;
v2 := v.01 + 1;
v3 := v.0 + 1;
TO: speedDis1_bb2_v.12;
FROM: speedDis1_bb2_v.12;
assume(v.01 < vm);
v.12 := v2;
TO: speedDis1_bb2_sv.12;

FROM: speedDis1_bb2_v.12;
assume(v.01 >= vm);
v.12 := v.01;
TO: speedDis1_bb2_sv.12;

FROM: speedDis1_bb2_sv.12;
TO: speedDis1_bb2_v.1;
FROM: speedDis1_bb2_v.1;
assume(v.01 < vm);
v.1 := v.0;
TO: speedDis1_bb2_sv.1;

FROM: speedDis1_bb2_v.1;
assume(v.01 >= vm);
v.1 := v3;
TO: speedDis1_bb2_sv.1;

FROM: speedDis1_bb2_sv.1;
var__temp_v.01 := v.12;
var__temp_v.0 := v.1;
TO: speedDis1_bb1;

FROM: speedDis1_bb3;
TO: speedDis1_bb3_ret;

