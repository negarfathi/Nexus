///*** 1_rank2 ***///
START: rank2_bb0;

FROM: rank2_bb0;
var__temp_vx.0 := vm;
var__temp_vy.0 := vm;
TO: rank2_bb1;

FROM: rank2_bb1;
vx.0 := var__temp_vx.0;
vy.0 := var__temp_vy.0;
TO: rank2_bb1_end;

FROM: rank2_bb1_end;
assume(vx.0 >= 2);
TO: rank2_bb2;

FROM: rank2_bb1_end;
assume(vx.0 < 2);
TO: rank2_bb6;

FROM: rank2_bb2;
v1 := vx.0 + -1;
v2 := vy.0 + v1;
var__temp_vy.1 := v2;
TO: rank2_bb3;

FROM: rank2_bb3;
vy.1 := var__temp_vy.1;
TO: rank2_bb3_end;

FROM: rank2_bb3_end;
assume(vy.1 >= v1);
TO: rank2_bb4;

FROM: rank2_bb3_end;
assume(vy.1 < v1);
TO: rank2_.critedge;

FROM: rank2_bb4;
v4 := nondet();
TO: rank2_bb4_end;

FROM: rank2_bb4_end;
assume(v4 > 0);
TO: rank2_bb5;

FROM: rank2_bb4_end;
assume(v4 <= 0);
TO: rank2_.critedge;

FROM: rank2_bb5;
v6 := vy.1 + -1;
var__temp_vy.1 := v6;
TO: rank2_bb3;

FROM: rank2_.critedge;
v7 := v1 + -1;
v8 := vy.1 - v7;
var__temp_vx.0 := v7;
var__temp_vy.0 := v8;
TO: rank2_bb1;

FROM: rank2_bb6;
TO: rank2_bb6_ret;

