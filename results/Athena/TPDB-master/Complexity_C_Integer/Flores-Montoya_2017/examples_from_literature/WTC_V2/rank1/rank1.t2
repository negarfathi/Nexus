///*** 1_rank1 ***///
START: rank1_bb0;

FROM: rank1_bb0;
var__temp_vx.0 := vm;
var__temp_vy.0 := 0;
TO: rank1_bb1;

FROM: rank1_bb1;
vx.0 := var__temp_vx.0;
vy.0 := var__temp_vy.0;
TO: rank1_bb1_end;

FROM: rank1_bb1_end;
assume((vx.0 >= 0) && (vy.0 >= 0));
TO: rank1_bb2;

FROM: rank1_bb1_end;
assume((vx.0 < 0) || (vy.0 < 0));
TO: rank1_bb7;

FROM: rank1_bb2;
v2 := nondet();
var__temp_vy.1 := vy.0;
var__temp_vx.1 := vx.0;
var__temp_vy.2 := vy.0;
TO: rank1_bb2_end;

FROM: rank1_bb2_end;
assume(v2 > 0);
TO: rank1_bb3;

FROM: rank1_bb2_end;
assume(v2 <= 0);
TO: rank1_bb6;

FROM: rank1_bb3;
vy.1 := var__temp_vy.1;
TO: rank1_bb3_end;

FROM: rank1_bb3_end;
assume(vy.1 <= vm);
TO: rank1_bb4;

FROM: rank1_bb3_end;
assume(vy.1 > vm);
TO: rank1_.critedge;

FROM: rank1_bb4;
v5 := nondet();
TO: rank1_bb4_end;

FROM: rank1_bb4_end;
assume(v5 > 0);
TO: rank1_bb5;

FROM: rank1_bb4_end;
assume(v5 <= 0);
TO: rank1_.critedge;

FROM: rank1_bb5;
v7 := vy.1 + 1;
var__temp_vy.1 := v7;
TO: rank1_bb3;

FROM: rank1_.critedge;
v8 := vx.0 + -1;
var__temp_vx.1 := v8;
var__temp_vy.2 := vy.1;
TO: rank1_bb6;

FROM: rank1_bb6;
vx.1 := var__temp_vx.1;
vy.2 := var__temp_vy.2;
v9 := vy.2 + -1;
var__temp_vx.0 := vx.1;
var__temp_vy.0 := v9;
TO: rank1_bb1;

FROM: rank1_bb7;
TO: rank1_bb7_ret;

