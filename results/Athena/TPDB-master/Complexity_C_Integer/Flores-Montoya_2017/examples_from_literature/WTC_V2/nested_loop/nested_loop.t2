FROM: nested_loop_bb6_end;
assume(v11 > 0);
TO: nested_loop_bb7;

FROM: nested_loop_bb6_end;
assume(v11 <= 0);
TO: nested_loop_.critedge3;

FROM: nested_loop_bb7;
v13 := vk.0 + 1;
var__temp_vk.0 := v13;
TO: nested_loop_bb5;

FROM: nested_loop_.critedge2;
v14 := vi.1 + 1;
var__temp_vi.0 := v14;
TO: nested_loop_bb1;

FROM: nested_loop_.critedge;
TO: nested_loop_.critedge_ret;

