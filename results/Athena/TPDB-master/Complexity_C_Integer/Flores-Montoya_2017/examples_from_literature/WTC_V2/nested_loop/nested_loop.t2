///*** 1_nested_loop ***///
START: nested_loop_bb0;

FROM: nested_loop_bb0;
var__temp_vi.0 := 0;
TO: nested_loop_bb0_end;

FROM: nested_loop_bb0_end;
assume(((0 <= vn) && (0 <= vm)) && (0 <= vN));
TO: nested_loop_bb1;

FROM: nested_loop_bb0_end;
assume(((0 > vn) || (0 > vm)) || (0 > vN));
TO: nested_loop_.critedge;

FROM: nested_loop_bb1;
vi.0 := var__temp_vi.0;
TO: nested_loop_bb1_end;

FROM: nested_loop_bb1_end;
assume(vi.0 < vn);
TO: nested_loop_bb2;

FROM: nested_loop_bb1_end;
assume(vi.0 >= vn);
TO: nested_loop_.critedge;

FROM: nested_loop_bb2;
v4 := nondet();
var__temp_vj.0 := 0;
var__temp_vi.1 := vi.0;
TO: nested_loop_bb2_end;

FROM: nested_loop_bb2_end;
assume(v4 > 0);
TO: nested_loop_.critedge3;

FROM: nested_loop_bb2_end;
assume(v4 <= 0);
