assume(v7 > 0);
TO: nested_loop_bb4;

FROM: nested_loop_bb3_end;
assume(v7 <= 0);
TO: nested_loop_.critedge2;

FROM: nested_loop_bb4;
v9 := vj.0 + 1;
var__temp_vk.0 := vi.1;
TO: nested_loop_bb5;

FROM: nested_loop_bb5;
vk.0 := var__temp_vk.0;
var__temp_vj.0 := v9;
var__temp_vi.1 := vk.0;
TO: nested_loop_bb5_end;

FROM: nested_loop_bb5_end;
assume(vk.0 < vN);
TO: nested_loop_bb6;

FROM: nested_loop_bb5_end;
assume(vk.0 >= vN);
