///*** 1_wcet0 ***///
START: wcet0_bb0;

FROM: wcet0_bb0;
var__temp_vj.0 := 0;
var__temp_vi.0 := vn;
TO: wcet0_bb0_end;

FROM: wcet0_bb0_end;
assume(vn >= 1);
TO: wcet0_bb1;

FROM: wcet0_bb0_end;
assume(vn < 1);
TO: wcet0_bb5;

FROM: wcet0_bb1;
vj.0 := var__temp_vj.0;
vi.0 := var__temp_vi.0;
v1 := nondet();
TO: wcet0_bb1_end;

FROM: wcet0_bb1_end;
assume(v1 > 0);
TO: wcet0_bb2;

FROM: wcet0_bb1_end;
assume(v1 <= 0);
TO: wcet0_bb3;

FROM: wcet0_bb2;
v3 := vj.0 + 1;
TO: wcet0_bb2_v.;
FROM: wcet0_bb2_v.;
assume(v3 >= vn);
v. := 0;
TO: wcet0_bb2_sv.;

FROM: wcet0_bb2_v.;
assume(v3 < vn);
v. := v3;
TO: wcet0_bb2_sv.;

FROM: wcet0_bb2_sv.;
var__temp_vj.3 := v.;
TO: wcet0_bb4;

FROM: wcet0_bb3;
v5 := vj.0 + -1;
v6 := 0 - vn;
TO: wcet0_bb3_v.1;
FROM: wcet0_bb3_v.1;
assume(v5 <= v6);
v.1 := 0;
TO: wcet0_bb3_sv.1;

FROM: wcet0_bb3_v.1;
assume(v5 > v6);
v.1 := v5;
TO: wcet0_bb3_sv.1;

FROM: wcet0_bb3_sv.1;
var__temp_vj.3 := v.1;
TO: wcet0_bb4;

FROM: wcet0_bb4;
vj.3 := var__temp_vj.3;
v8 := vi.0 + -1;
var__temp_vj.0 := vj.3;
var__temp_vi.0 := v8;
TO: wcet0_bb4_end;

FROM: wcet0_bb4_end;
assume(v8 > 0);
TO: wcet0_bb1;

FROM: wcet0_bb4_end;
assume(v8 <= 0);
TO: wcet0_bb5;

FROM: wcet0_bb5;
TO: wcet0_bb5_ret;

