///*** 1_speedSingleSingle ***///
START: speedSingleSingle_bb0;

FROM: speedSingleSingle_bb0;
var__temp_vx.0 := 0;
TO: speedSingleSingle_bb1;

FROM: speedSingleSingle_bb1;
vx.0 := var__temp_vx.0;
TO: speedSingleSingle_bb1_end;

FROM: speedSingleSingle_bb1_end;
assume(vx.0 < vn);
TO: speedSingleSingle_bb2;

FROM: speedSingleSingle_bb1_end;
assume(vx.0 >= vn);
TO: speedSingleSingle_bb3;

FROM: speedSingleSingle_bb2;
v1 := nondet();
v2 := vx.0 + 1;
var__temp_vx.0 := v2;
TO: speedSingleSingle_bb1;

FROM: speedSingleSingle_bb3;
TO: speedSingleSingle_bb3_ret;

