///*** 1_perfect1 ***///
START: perfect1_bb0;

FROM: perfect1_bb0;
var__temp_v.0 := 0;
TO: perfect1_bb0_end;

FROM: perfect1_bb0_end;
assume(vx <= 1);
TO: perfect1_bb7;

FROM: perfect1_bb0_end;
assume(vx > 1);
TO: perfect1_bb1;

FROM: perfect1_bb1;
v1 := vx - 1;
var__temp_vy3.0 := vx;
var__temp_vy1.0 := v1;
TO: perfect1_bb2;

FROM: perfect1_bb2;
vy3.0 := var__temp_vy3.0;
vy1.0 := var__temp_vy1.0;
var__temp_vy2.1 := vx;
TO: perfect1_bb2_end;

FROM: perfect1_bb2_end;
assume(vy1.0 > 0);
TO: perfect1_bb3;

FROM: perfect1_bb2_end;
assume(vy1.0 <= 0);
TO: perfect1_bb6;

FROM: perfect1_bb3;
vy2.1 := var__temp_vy2.1;
TO: perfect1_bb3_end;

FROM: perfect1_bb3_end;
assume(vy2.1 >= vy1.0);
TO: perfect1_bb4;

FROM: perfect1_bb3_end;
assume(vy2.1 < vy1.0);
TO: perfect1_bb5;

FROM: perfect1_bb4;
v4 := vy2.1 - vy1.0;
var__temp_vy2.1 := v4;
TO: perfect1_bb3;

FROM: perfect1_bb5;
v6 := vy3.0 - vy1.0;
TO: perfect1_bb5_v.y3.0;
FROM: perfect1_bb5_v.y3.0;
assume(vy2.1 == 0);
v.y3.0 := v6;
TO: perfect1_bb5_sv.y3.0;

FROM: perfect1_bb5_v.y3.0;
assume(vy2.1 != 0);
v.y3.0 := vy3.0;
TO: perfect1_bb5_sv.y3.0;

FROM: perfect1_bb5_sv.y3.0;
v7 := vy1.0 + -1;
var__temp_vy3.0 := v.y3.0;
var__temp_vy1.0 := v7;
TO: perfect1_bb2;

FROM: perfect1_bb6;
TO: perfect1_bb6_v8;

FROM: perfect1_bb6_v8;
assume(vy3.0 == 0);
v8 := 1;
TO: perfect1_bb6_sv8;

FROM: perfect1_bb6_v8;
assume(vy3.0 != 0);
v8 := 0;
TO: perfect1_bb6_sv8;

FROM: perfect1_bb6_sv8;
v9 := v8;
var__temp_v.0 := v9;
TO: perfect1_bb7;

FROM: perfect1_bb7;
v.0 := var__temp_v.0;
TO: perfect1_bb7_ret;

