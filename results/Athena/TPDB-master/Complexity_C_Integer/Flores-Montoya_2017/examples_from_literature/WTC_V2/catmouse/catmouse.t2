///*** 1_catmouse ***///
START: catmouse_bb0;

FROM: catmouse_bb0;
var__temp_vx.0 := 0;
TO: catmouse_bb1;

FROM: catmouse_bb1;
vx.0 := var__temp_vx.0;
TO: catmouse_bb1_end;

FROM: catmouse_bb1_end;
assume(vx.0 <= vn);
TO: catmouse_bb2;

FROM: catmouse_bb1_end;
assume(vx.0 > vn);
TO: catmouse_bb3;

FROM: catmouse_bb2;
v2 := vx.0 + 1;
v3 := vx.0 + -1;
TO: catmouse_bb2_vx.1;
FROM: catmouse_bb2_vx.1;
assume(vx.0 <= vm);
vx.1 := v2;
TO: catmouse_bb2_svx.1;

FROM: catmouse_bb2_vx.1;
assume(vx.0 > vm);
vx.1 := v3;
TO: catmouse_bb2_svx.1;

FROM: catmouse_bb2_svx.1;
var__temp_vx.0 := vx.1;
TO: catmouse_bb1;

FROM: catmouse_bb3;
TO: catmouse_bb3_ret;

