///*** 1_hc_compute ***///
START: hc_compute_bb0;

FROM: hc_compute_bb0;
var__temp_vi.0 := vnum_values;
TO: hc_compute_bb1;

FROM: hc_compute_bb1;
vi.0 := var__temp_vi.0;
var__temp_vi.0.sink := vi.0;
TO: hc_compute_bb1_end;

FROM: hc_compute_bb1_end;
assume(vi.0 > 0);
TO: hc_compute_bb2;

FROM: hc_compute_bb1_end;
assume(vi.0 <= 0);
TO: hc_compute_bb8;

FROM: hc_compute_bb2;
vi.0.sink := var__temp_vi.0.sink;
v1 := vi.0.sink + -1;
TO: hc_compute_bb2_end;

FROM: hc_compute_bb2_end;
assume(v1 > 0);
TO: hc_compute_bb3;

FROM: hc_compute_bb2_end;
assume(v1 <= 0);
TO: hc_compute_.critedge;

FROM: hc_compute_bb3;
v3 := nondet();
var__temp_vi.0.sink := v1;
TO: hc_compute_bb3_end;

FROM: hc_compute_bb3_end;
assume(v3 != 0);
TO: hc_compute_bb2;

FROM: hc_compute_bb3_end;
assume(v3 == 0);
TO: hc_compute_.critedge;

FROM: hc_compute_.critedge;
v5 := vi.0 - v1;
var__temp_vx.0 := v5;
TO: hc_compute_bb4;

FROM: hc_compute_bb4;
vx.0 := var__temp_vx.0;
var__temp_vi.0 := v1;
var__temp_vy.0 := vx.0;
TO: hc_compute_bb4_end;

FROM: hc_compute_bb4_end;
assume(vx.0 > 0);
TO: hc_compute_bb5;

FROM: hc_compute_bb4_end;
assume(vx.0 <= 0);
TO: hc_compute_bb1;

FROM: hc_compute_bb5;
vy.0 := var__temp_vy.0;
TO: hc_compute_bb5_end;

FROM: hc_compute_bb5_end;
assume(vy.0 > 0);
TO: hc_compute_bb6;

FROM: hc_compute_bb5_end;
assume(vy.0 <= 0);
TO: hc_compute_.critedge1;

FROM: hc_compute_bb6;
v8 := nondet();
TO: hc_compute_bb6_end;

FROM: hc_compute_bb6_end;
assume(v8 != 0);
TO: hc_compute_bb7;

FROM: hc_compute_bb6_end;
assume(v8 == 0);
TO: hc_compute_.critedge1;

FROM: hc_compute_bb7;
v10 := vy.0 + -1;
var__temp_vy.0 := v10;
TO: hc_compute_bb5;

FROM: hc_compute_.critedge1;
v11 := vx.0 + -1;
var__temp_vx.0 := v11;
TO: hc_compute_bb4;

FROM: hc_compute_bb8;
TO: hc_compute_bb8_ret;

