FROM: subsetdump_bb6;
v7 := nondet();
var__temp_vrangestart.0 := vcnum.0;
var__temp_vcnum.2 := vcnum.1;
TO: subsetdump_bb6_end;

FROM: subsetdump_bb6_end;
assume(v7 != 0);
TO: subsetdump_bb7;

FROM: subsetdump_bb6_end;
assume(v7 == 0);
TO: subsetdump_bb9;

FROM: subsetdump_bb7;
vrangestart.0 := var__temp_vrangestart.0;
var__temp_vcnum.2 := vcnum.1;
TO: subsetdump_bb7_end;

FROM: subsetdump_bb7_end;
assume(vrangestart.0 < vcnum.1);
TO: subsetdump_bb8;

FROM: subsetdump_bb7_end;
assume(vrangestart.0 >= vcnum.1);
TO: subsetdump_bb9;

FROM: subsetdump_bb8;
v10 := vrangestart.0 + 1;
var__temp_vrangestart.0 := v10;
TO: subsetdump_bb7;

FROM: subsetdump_bb9;
vcnum.2 := var__temp_vcnum.2;
v11 := vcnum.2 + 1;
