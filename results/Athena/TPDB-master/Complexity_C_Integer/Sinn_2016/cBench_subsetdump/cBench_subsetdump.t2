var__temp_vcnum.2 := vcnum.0;
TO: subsetdump_bb2_end;

FROM: subsetdump_bb2_end;
assume(v1 != 0);
TO: subsetdump_bb3;

FROM: subsetdump_bb2_end;
assume(v1 == 0);
TO: subsetdump_bb9;

FROM: subsetdump_bb3;
vcnum.1 := var__temp_vcnum.1;
TO: subsetdump_bb3_end;

FROM: subsetdump_bb3_end;
assume(vcnum.1 < vlimit);
TO: subsetdump_bb4;

FROM: subsetdump_bb3_end;
assume(vcnum.1 >= vlimit);
TO: subsetdump_bb6;

FROM: subsetdump_bb4;
v4 := nondet();
TO: subsetdump_bb4_end;

FROM: subsetdump_bb4_end;
assume(v4 != 0);
TO: subsetdump_bb6;

FROM: subsetdump_bb4_end;
assume(v4 == 0);
TO: subsetdump_bb5;

FROM: subsetdump_bb5;
v6 := vcnum.1 + 1;
var__temp_vcnum.1 := v6;
