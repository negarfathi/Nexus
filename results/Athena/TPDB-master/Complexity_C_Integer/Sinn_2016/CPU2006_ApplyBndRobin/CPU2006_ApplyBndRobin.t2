TO: ApplyBndRobin_bb9;

FROM: ApplyBndRobin_bb8_end;
assume(vj.0 != 0);
TO: ApplyBndRobin_bb10;

FROM: ApplyBndRobin_bb9;
v10 := nondet();
var__temp_vdy.1 := 1;
TO: ApplyBndRobin_bb9_end;

FROM: ApplyBndRobin_bb9_end;
assume(v10 != 0);
TO: ApplyBndRobin_bb11;

FROM: ApplyBndRobin_bb9_end;
assume(v10 == 0);
TO: ApplyBndRobin_bb10;

FROM: ApplyBndRobin_bb10;
v12 := nondet();
TO: ApplyBndRobin_bb10_v.1;
FROM: ApplyBndRobin_bb10_v.1;
assume(v12 != 0);
v.1 := -1;
