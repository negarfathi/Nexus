FROM: ApplyBndRobin_bb5_v.;
assume(v6 == 0);
v. := 0;
TO: ApplyBndRobin_bb5_sv.;

FROM: ApplyBndRobin_bb5_sv.;
var__temp_vdz.1 := v.;
TO: ApplyBndRobin_bb6;

FROM: ApplyBndRobin_bb6;
