///*** 1_send_tree ***///
START: send_tree_bb0;

FROM: send_tree_bb0;
var__temp_vcount.0 := 0;
var__temp_vn.0 := 0;
TO: send_tree_bb1;

FROM: send_tree_bb1;
vcount.0 := var__temp_vcount.0;
vn.0 := var__temp_vn.0;
TO: send_tree_bb1_end;

FROM: send_tree_bb1_end;
assume(vn.0 <= vmax_code);
TO: send_tree_bb2;

FROM: send_tree_bb1_end;
assume(vn.0 > vmax_code);
TO: send_tree_bb9;

FROM: send_tree_bb2;
v1 := vcount.0 + 1;
TO: send_tree_bb2_end;

FROM: send_tree_bb2_end;
assume(v1 < vmax_count);
TO: send_tree_bb3;

FROM: send_tree_bb2_end;
assume(v1 >= vmax_count);
TO: send_tree_bb4;

FROM: send_tree_bb3;
v3 := nondet();
var__temp_vcount.2 := v1;
TO: send_tree_bb3_end;

FROM: send_tree_bb3_end;
assume(v3 != 0);
TO: send_tree_bb8;

FROM: send_tree_bb3_end;
assume(v3 == 0);
TO: send_tree_bb4;

FROM: send_tree_bb4;
var__temp_vcount.1 := v1;
TO: send_tree_bb4_end;

FROM: send_tree_bb4_end;
assume(v1 < vmin_count);
TO: send_tree_bb5;

FROM: send_tree_bb4_end;
assume(v1 >= vmin_count);
TO: send_tree_bb6;

FROM: send_tree_bb5;
vcount.1 := var__temp_vcount.1;
v6 := vcount.1 + -1;
var__temp_vcount.1 := v6;
var__temp_vcount.2 := 0;
TO: send_tree_bb5_end;

FROM: send_tree_bb5_end;
assume(v6 > 0);
TO: send_tree_bb5;

FROM: send_tree_bb5_end;
assume(v6 <= 0);
TO: send_tree_bb8;

FROM: send_tree_bb6;
v8 := nondet();
var__temp_vcount.2 := 0;
TO: send_tree_bb6_end;

FROM: send_tree_bb6_end;
assume(v8 != 0);
TO: send_tree_bb7;

FROM: send_tree_bb6_end;
assume(v8 == 0);
TO: send_tree_bb8;

FROM: send_tree_bb7;
v10 := nondet();
var__temp_vcount.2 := 0;
TO: send_tree_bb8;

FROM: send_tree_bb8;
vcount.2 := var__temp_vcount.2;
v11 := vn.0 + 1;
var__temp_vcount.0 := vcount.2;
var__temp_vn.0 := v11;
TO: send_tree_bb1;

FROM: send_tree_bb9;
TO: send_tree_bb9_ret;

