///*** 1_Configure ***///
START: Configure_bb0;

FROM: Configure_bb0;
var__temp_vCLcount.2 := 1;
TO: Configure_bb0_end;

FROM: Configure_bb0_end;
assume(vac >= 3);
TO: Configure_bb1;

FROM: Configure_bb0_end;
assume(vac < 3);
TO: Configure_bb2;

FROM: Configure_bb1;
v1 := nondet();
TO: Configure_bb1_v.;
FROM: Configure_bb1_v.;
assume(v1 != 0);
v. := 3;
TO: Configure_bb1_sv.;

FROM: Configure_bb1_v.;
assume(v1 == 0);
v. := 1;
TO: Configure_bb1_sv.;

FROM: Configure_bb1_sv.;
var__temp_vCLcount.2 := v.;
TO: Configure_bb2;

FROM: Configure_bb2;
vCLcount.2 := var__temp_vCLcount.2;
TO: Configure_bb2_end;

FROM: Configure_bb2_end;
assume(vCLcount.2 < vac);
TO: Configure_bb3;

FROM: Configure_bb2_end;
assume(vCLcount.2 >= vac);
TO: Configure_bb11;

FROM: Configure_bb3;
v4 := nondet();
TO: Configure_bb3_end;

FROM: Configure_bb3_end;
assume(v4 != 0);
TO: Configure_bb4;

FROM: Configure_bb3_end;
assume(v4 == 0);
TO: Configure_bb5;

FROM: Configure_bb4;
v6 := vCLcount.2 + 2;
var__temp_vCLcount.2 := v6;
TO: Configure_bb2;

FROM: Configure_bb5;
v7 := nondet();
TO: Configure_bb5_end;

FROM: Configure_bb5_end;
assume(v7 != 0);
TO: Configure_bb6;

FROM: Configure_bb5_end;
assume(v7 == 0);
TO: Configure_bb11;

FROM: Configure_bb6;
v9 := vCLcount.2 + 1;
var__temp_vNumberParams.0 := v9;
TO: Configure_bb7;

FROM: Configure_bb7;
vNumberParams.0 := var__temp_vNumberParams.0;
var__temp_vCLcount.3 := v9;
TO: Configure_bb7_end;

FROM: Configure_bb7_end;
assume(vNumberParams.0 < vac);
TO: Configure_bb8;

FROM: Configure_bb7_end;
assume(vNumberParams.0 >= vac);
TO: Configure_.critedge;

FROM: Configure_bb8;
v11 := nondet();
var__temp_vCLcount.3 := v9;
TO: Configure_bb8_end;

FROM: Configure_bb8_end;
assume(v11 != 0);
TO: Configure_bb9;

FROM: Configure_bb8_end;
assume(v11 == 0);
TO: Configure_.critedge;

FROM: Configure_bb9;
v13 := vNumberParams.0 + 1;
var__temp_vNumberParams.0 := v13;
TO: Configure_bb7;

FROM: Configure_.critedge;
vCLcount.3 := var__temp_vCLcount.3;
var__temp_vCLcount.2 := vCLcount.3;
TO: Configure_.critedge_end;

FROM: Configure_.critedge_end;
assume(vCLcount.3 < vNumberParams.0);
TO: Configure_bb10;

FROM: Configure_.critedge_end;
assume(vCLcount.3 >= vNumberParams.0);
TO: Configure_bb2;

FROM: Configure_bb10;
v15 := vCLcount.3 + 1;
var__temp_vCLcount.3 := v15;
TO: Configure_.critedge;

FROM: Configure_bb11;
TO: Configure_bb11_ret;

